# PostgreSQL instance (admin credentials)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_USE_SSL=false
DB_INSECURE=false

# Session cookie signing
SESSION_COOKIE_NAME=self_db_session
SESSION_SECRET=

# Options applied to CREATE ROLE for each provisioned user
ROLE_OPTIONS=NOSUPERUSER,CREATEDB,CREATEROLE,INHERIT

# RDS Proxy (leave RDS_PROXY_NAME empty for a plain PostgreSQL instance)
RDS_PROXY_NAME=
RDS_PROXY_AUTH_SECRET_PREFIX=self-service-db-users
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# Values shown to users in the UI
NEXT_PUBLIC_DB_HOST=
NEXT_PUBLIC_DB_PORT=
NEXT_PUBLIC_DB_SSL_MODE=
NEXT_PUBLIC_PREFIX_DB_NAME_WITH_USERNAME=false

# Feature toggles
NEXT_PUBLIC_DISABLE_USER_REGISTRATION=false
NEXT_PUBLIC_DISABLE_DATABASE_CREATION=false

# Optional UI links / hints
NEXT_PUBLIC_HELP_URL=
NEXT_PUBLIC_LOGIN_HINT=
